# Скопируй в .env и заполни значениями.

# --- Окружение ---
NODE_ENV=production

# --- База данных ---
# В production payload.config берёт DATABASE_URL_PROD.
# Локально (dev) — DATABASE_URL_LOCAL.
DATABASE_URL_PROD=postgresql://detdom:PASSWORD@localhost:5432/detdom
DATABASE_URL_LOCAL=postgresql://detdom:PASSWORD@localhost:5432/detdom
DATABASE_URL=postgresql://detdom:PASSWORD@localhost:5432/detdom

# --- Payload ---
PAYLOAD_SECRET=change-me-32-hex
PREVIEW_SECRET=change-me-32-hex

# --- Сайт ---
NEXT_PUBLIC_SITE_URL=https://example.ru
PORT=3000
