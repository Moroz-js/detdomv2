    }
  },
  {
    "title": "«Семья на первом месте»",
    "slug": "semya-na-pervom-meste",
    "publishedAt": "2026-06-24T00:00:00.000Z",
    "excerpt": null,
    "thumbnailUrl": "/media/2026/06/image1-10.jpeg",
    "galleryUrls": [
      {
        "url": "/media/2026/06/image4-9.jpeg",
        "alt": ""
      },
      {
        "url": "/media/2026/06/image3-10.jpeg",
        "alt": ""
      },
      {
        "url": "/media/2026/06/image2-10.jpeg",
        "alt": ""
      },
      {
        "url": "/media/2026/06/image8-4.jpeg",
        "alt": ""
      },
      {
        "url": "/media/2026/06/image7-4.jpeg",
        "alt": ""
      },
      {
        "url": "/media/2026/06/image6-5.jpeg",
        "alt": ""
      },
      {
        "url": "/media/2026/06/image5-7.jpeg",
        "alt": ""
      }
    ],
    "content": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "direction": "ltr",
        "children": [
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "Сохранить семью, поддержав родителей",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "Почти в каждом втором случае, когда ребёнок оказывается в учреждении, причиной становится алкогольная или наркотическая зависимость родителей. За этой статистикой — семьи, которым зачастую нужна не разовая мера, а длительная и профессиональная помощь.",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "Как выстроить такую систему, 18 июня обсуждали в Чите на стратегической сессии «Семья на первом месте». Площадка собрала более 300 специалистов из регионов Дальнего Востока, Москвы, Санкт-Петербурга, Сибири и Поволжья.",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "➡️ За одним столом встретились представители органов власти, социальной защиты и здравоохранения, уполномоченные по правам ребёнка, руководители учреждений и некоммерческих организаций. Главный вопрос звучал предельно конкретно: как помочь маме или папе преодолеть зависимость, не разрушив при этом семью?",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "Приморский край представила межведомственная команда:",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "— Уполномоченный по правам ребёнка в Приморском крае Ольга Романова;",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "— помощник Губернатора Приморского края, региональный куратор специального проекта «Вызов» Ирина Медведева;",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "— ответственный секретарь Приморской краевой межведомственной комиссии по делам несовершеннолетних и защите их прав Светлана Башинская;",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "— директор Спасского социально-реабилитационного центра для несовершеннолетних Ирина Боровая;",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "— заместитель директора Комплексного центра помощи семье и детям города Уссурийска, руководитель супервизорской службы поддержки специалистов системы профилактики социального сиротства Светлана Лебедева.",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "— заведующий амбулаторно-поликлиническим отделением Краевого наркологического диспансера Игорь Ковалев;",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "На сессии регионы представили практики, которые уже помогают родителям вернуться к трезвой жизни и восстановить отношения с детьми. Участники сошлись во мнении: помощь должна быть доступна в разных форматах — от первичной консультации и амбулаторного лечения до полноценной реабилитации без разлучения с ребёнком.",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "Но завершение лечения — ещё не финал. Семье необходимо сопровождение и после реабилитации: помощь в восстановлении доверия, укреплении детско-родительских отношений и предупреждении повторного кризиса. Без этого даже хороший результат может оказаться непрочным.",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "❗Предложения, сформированные по итогам встречи, войдут в дальнейшую работу межведомственной рабочей группы по вопросам помощи семьям с детьми и профилактики социального сиротства.",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "Благодарим Правительство Забайкальского края и Губернатора Александра Осипова, полномочного представителя Президента Российской Федерации в Дальневосточном федеральном округе Юрия Трутнева, а также Фонд поддержки детей, находящихся в трудной жизненной ситуации, за организацию площадки.",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "Сохранить ребёнку родную семью можно только тогда, когда помощь вовремя получает не один человек, а вся семья.",
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          },
          {
            "type": "paragraph",
            "version": 1,
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "text": "",
                "detail": 0,
                "format": 1,
                "mode": "normal",
                "style": "",
                "version": 1
              }
            ]
          }
        ]
      }
    },
